# barion (front) — DESARROLLO
# El código se monta por volumen desde el compose del repo padre (hot reload de next dev).
# node_modules vive en un volumen anónimo del contenedor.

FROM node:22-alpine
WORKDIR /app
RUN corepack enable pnpm

COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

# El código llega por volumen; esta copia solo cubre el primer build
COPY . .

EXPOSE 2203
ENV NEXT_TELEMETRY_DISABLED=1

CMD ["pnpm", "dev"]
