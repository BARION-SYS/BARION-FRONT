# barion (front) — copiar a .env (dev) / .env.production (prod)

# Puerto en el que escucha Next. Es el mismo DENTRO del contenedor y en el host:
# el compose mapea DEV_WEB_PORT:21003 y `Dockerfile.dev` declara EXPOSE 21003. Sin esta
# variable `next dev` se va a 3000 y el contenedor arranca sano con el puerto
# publicado sin nadie detrás — el fallo más difícil de leer de los dos.
PORT=21003

# URL de la API vista desde el NAVEGADOR (no desde el contenedor), prefijo /v1
NEXT_PUBLIC_API_URL=http://localhost:21001/api/v1

# Dominio del SITIO PÚBLICO (repo BARION-WEB), otro despliegue: destino del
# «volver al inicio» del 404 y del final del registro. Obligatoria.
NEXT_PUBLIC_LANDING_URL=http://localhost:21004

# Orígenes permitidos en dev (proxy/HMR), separados por coma — solo servidor, no
# llega al cliente. Detrás de un proxy con dominio, poner ese dominio SIN esquema.
ALLOWED_DEV_ORIGINS=
