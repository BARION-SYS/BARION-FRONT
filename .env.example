# barion (front) — copiar a .env (dev) / .env.production (prod)

# URL de la API vista desde el NAVEGADOR (no desde el contenedor), prefijo /v1
NEXT_PUBLIC_API_URL=http://localhost:4000/v1

# Orígenes permitidos en dev (proxy/HMR), separados por coma — solo servidor, no llega al cliente
ALLOWED_DEV_ORIGINS=demo-serviciudad.tecnovapp.com.co
