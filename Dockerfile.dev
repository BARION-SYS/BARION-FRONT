# barion (front) — DESARROLLO
#
# En este servidor se trabaja desde el HOST: el código Y node_modules se montan
# por volumen (compose del padre). Instalar deps = `pnpm add` en el host; el
# contenedor las ve al instante, sin rebuild ni reinicio.
#
# Base glibc (slim, NO alpine): los binarios nativos instalados desde el host
# —sharp, el swc de Next, lightningcss— están compilados contra glibc y no se
# ejecutan sobre la musl de Alpine. Compartir node_modules obliga a que ambos
# lados usen la misma libc, y es lo que permite que instalar una dependencia sea
# instantáneo en vez de reinstalar el árbol entero dentro.
FROM node:22-slim

# Quién es el contenedor: el uid de quien programa en esta máquina (`id -u`) y
# `1005`, el grupo que comparten los programadores.
#
# Importa porque el repo entero va montado por volumen: lo que el contenedor
# genere ahí dentro —la caché de compilación, un build— queda escribible para
# todos ellos y no solo para quien levantó el entorno.
#
# Se cambian sin tocar este archivo:
#   docker compose -f docker-compose.dev.yml build --build-arg UID=1001 web
ARG UID=1000
ARG GID=1005

# Versión EXACTA la que fija `packageManager` en package.json. pnpm 10 se
# automantiene: si la global no coincide al carácter, ANTES de cualquier comando
# se reinstala a sí mismo — una descarga en cada arranque que además escribe
# donde el contenedor no puede. Al subir el pin en el front, subir esta línea.
RUN npm install -g pnpm@10.33.3

# Un usuario de VERDAD, con su grupo y su home.
#
# Antes el compose pasaba `user: "1002:1002"` contra una imagen que no conocía
# ese uid: quedaba un usuario sin entrada en /etc/passwd y sin home, y había que
# apuntar `HOME` a /tmp para que las herramientas no escribieran en `/`. Con el
# usuario declarado aquí, `~` existe y vale para todas.
#
# El grupo se crea solo si el gid está libre.
#
# Y el usuario se REUTILIZA cuando el uid ya existe, que es el caso corriente y
# no el raro: `node:22-slim` trae un usuario `node` en el 1000, y 1000 es
# justamente el uid del primer humano de casi cualquier Linux. Ahí dentro,
# `useradd -u 1000` responde «UID 1000 is not unique» y tumba el build — o sea
# que el único valor que la imagen no aceptaba era precisamente el correcto para
# la máquina de quien programa.
#
# Cuando el uid está ocupado se le cambia el nombre a `app`, se le mueve el home
# a /home/app y se le pone el grupo pedido, en vez de crear una segunda cuenta:
# dos cuentas con el mismo uid son la misma cuenta para el kernel, y lo único
# que cambiaría es cuál de los dos nombres enseña `ls`.
RUN set -eu; \
    if ! getent group "${GID}" >/dev/null; then groupadd -g "${GID}" programadores; fi; \
    if getent passwd "${UID}" >/dev/null; then \
      anterior="$(getent passwd "${UID}" | cut -d: -f1)"; \
      usermod -l app -g "${GID}" -d /home/app -m -s /bin/bash "$anterior"; \
    else \
      useradd -u "${UID}" -g "${GID}" -m -d /home/app -s /bin/bash app; \
    fi; \
    mkdir -p /app; \
    chown -R "${UID}:${GID}" /app /home/app

# `.next` NO se comparte con el host: el compose le monta encima un volumen de
# Docker. Este directorio existe en la imagen solo para fijarle el dueño — al
# crear el volumen, Docker lo hereda de aquí, y el contenedor no corre como
# root. Sin esto el volumen nace de root y Next no puede escribir su caché.
RUN mkdir -p /app/.next && chown ${UID}:${GID} /app/.next

# Store de pnpm FUERA de /app, y dentro del home del usuario. Por defecto pnpm
# lo pone en el home, ve que está en otro dispositivo que node_modules y cae a
# un store local del proyecto: `/app/.pnpm-store`, que por el bind mount es el
# repo del host. La variable es `npm_config_store_dir`: `PNPM_STORE_DIR` pnpm la
# ignora.
ENV HOME=/home/app
ENV npm_config_store_dir=/home/app/.pnpm-store
ENV NEXT_TELEMETRY_DISABLED=1

WORKDIR /app
USER ${UID}:${GID}

EXPOSE 21003

CMD ["pnpm", "dev"]
